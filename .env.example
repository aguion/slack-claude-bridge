# Copy this to .env; the bridge loads it automatically on startup.
# Anything already exported in your shell wins over the values here.

# Bot token — Slack app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...

# App-level token with the connections:write scope
# Slack app → Basic Information → App-Level Tokens → Generate
SLACK_APP_TOKEN=xapp-...

# Comma-separated Slack user IDs allowed to drive the bot.
# Find yours: Slack profile → ⋮ → Copy member ID. Looks like U01ABCDEFGH.
# Anyone not listed here is ignored outright. Do not leave this broad —
# a message to this bot runs code on your machine.
ALLOWED_SLACK_USER_IDS=U01ABCDEFGH

# --- optional ---

# Where thread→session mappings live. Default: ~/.slack-claude-bridge
# STATE_DIR=/Users/you/.slack-claude-bridge

# Channel→repo map. Default: ./projects.json
# PROJECTS_FILE=/Users/you/slack-claude-bridge/projects.json

# Seconds an approval prompt waits before auto-denying. Default: 300
# APPROVAL_TIMEOUT_SEC=300

# Max agent turns per Slack message. Default: 60
# MAX_TURNS=60

# Which on-disk Claude settings the agent may load, comma-separated.
# Default: project  (the repo's own .claude/settings.json and CLAUDE.md)
#
# Careful: a `permissions.allow` rule in ANY loaded settings file pre-approves
# that tool inside the SDK, so no Slack approval prompt appears for it. Adding
# `user` here means your personal ~/.claude/settings.json allow-rules apply to
# everything this bot does. Set to an empty value to load nothing at all
# (CLAUDE.md will not be read).
# SETTING_SOURCES=project

# Path to this file. Default: ./.env
# ENV_FILE=/Users/you/slack-claude-bridge/.env

# LOG_LEVEL=debug
