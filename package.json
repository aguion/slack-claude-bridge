{
  "name": "slack-claude-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Drive local Claude Code sessions from Slack over Socket Mode",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "doctor": "tsc && node dist/doctor.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@slack/bolt": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
